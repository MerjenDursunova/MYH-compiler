int sumGrid(int bias) {
    int grid[2][3] = {{1, 2, 3}, {4, 5, 6}};
    int i = 0;
    int j = 0;
    int total = 0;

    while (i < 2) {
        j = 0;
        while (j < 3) {
            total = total + grid[i][j];
            j = j + 1;
        }
        i = i + 1;
    }

    if (total > 20 && bias > 0) {
        total = total + bias;
    } else {
        total = total - 1;
    }

    return total;
}

int main() {
    int a = 4, b = 2 + 3;
    int answer = sumGrid(a + b);
    return answer;
}
